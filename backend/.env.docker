# Backend environment for Docker Compose
# This file is used by docker-compose.yml (backend service env_file)
# DATABASE_URL is overridden in docker-compose.yml to use the postgres service name.

APP_NAME=cognate-ai-api
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
API_PREFIX=/api/v1
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/app/storage
