# Cognate AI — Environment Variables
# Copy this file to .env and fill in the values for your local environment.

# ── Application ────────────────────────────────────────────────────────────────
APP_NAME=cognate-ai-api
APP_ENV=development
ENVIRONMENT=development
DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=8000
API_PREFIX=/api/v1

# ── Database ───────────────────────────────────────────────────────────────────
# Provide a private PostgreSQL connection URL for this environment.
DATABASE_URL=

# ── Storage ────────────────────────────────────────────────────────────────────
# Backend for document file storage.
# Phase 2: "local" — files written to STORAGE_LOCAL_PATH.
# Later:  "s3"    — files written to S3-compatible object storage.
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=../storage

# ── Providers ──────────────────────────────────────────────────────────────────
# OCR: "mock" (default/offline), "local" (tesseract/pypdf), or "azure"
OCR_PROVIDER=mock
AZURE_DOC_INTEL_ENDPOINT=
AZURE_DOC_INTEL_KEY=

# Extraction LLM: "mock" (default/offline) or "openai"
EXTRACTION_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ── Security ───────────────────────────────────────────────────────────────────
AUTH_DISABLED=false
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ISSUER=cognate-ai
JWT_AUDIENCE=cognate-ai-client
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_SESSION_EXPIRE_HOURS=12
AUTH_COOKIE_SECURE=false
PASSWORD_BLOCKLIST_FILE=
AUTH_ENCRYPTION_KEY=
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_PER_IP=30
AUTH_RATE_LIMIT_PER_ACCOUNT=10
AUTH_ENUMERATION_MIN_RESPONSE_MS=300
REGISTRATION_MODE=approval

# Email delivery. Keep disabled until a real SMTP/API provider is configured.
EMAIL_PROVIDER=
EMAIL_FROM=
PUBLIC_APP_URL=http://localhost:8443
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
EMAIL_SEND_TIMEOUT_SECONDS=10
EMAIL_RETRY_ATTEMPTS=3
EMAIL_RETRY_BACKOFF_SECONDS=0.25
EMAIL_CODE_COOLDOWN_SECONDS=60
EMAIL_CODE_DAILY_LIMIT=5
EMAIL_CODE_MAX_ATTEMPTS=5
RESEND_API_KEY=
SENDGRID_API_KEY=

# Optional configured local users. The CLI refuses production and passwords follow Argon2id policy:
# .\venv\Scripts\python.exe -m scripts.seed_dev_users
COGNATE_DEV_ADMIN_EMAIL=
COGNATE_DEV_ADMIN_PASSWORD=
COGNATE_DEV_OPERATOR_EMAIL=
COGNATE_DEV_OPERATOR_PASSWORD=

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Vite dev server runs on 5173 (default) or 8443 (Figma Make).
CORS_ORIGINS=http://localhost:5173,http://localhost:8443
